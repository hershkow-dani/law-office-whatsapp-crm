# Copy this file to .env (same folder as docker-compose.yml) and fill in
# real values before running `docker compose up -d`. .env is gitignored —
# never commit real secrets.

# Required. Any long random string — e.g. generate one with:
#   openssl rand -hex 32
SESSION_SECRET=

# WhatsApp — leave WHATSAPP_PROVIDER=mock until you have real Meta
# credentials (see docs/ARCHITECTURE.md "מה עדיין נדרש כדי להפעיל בפועל").
WHATSAPP_PROVIDER=mock
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Password-reset emails — leave EMAIL_PROVIDER=mock (logs to the server
# container's stdout instead of sending) until you have a Resend account.
EMAIL_PROVIDER=mock
RESEND_API_KEY=
EMAIL_FROM=

# The public URL the client is served from — used to build password-reset
# links. Update this to your real domain once you have one.
FRONTEND_ORIGIN=http://localhost:8080
